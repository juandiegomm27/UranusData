# CONFIGURACIÓN GENERAL - UranusData API
APP_NAME="UranusData"
APP_ENV=local
APP_KEY=base64:YOUR_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

# BASE DE DATOS - MySQL (CAMBIAR A TU CONEXIÓN)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=UranusData
DB_USERNAME=root
DB_PASSWORD=

# LOGGING & DEBUGGING
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SESIÓN & CACHE
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# MAIL - Para recuperación de contraseña y notificaciones
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@uranusdata.local"
MAIL_FROM_NAME="${APP_NAME}"

# Para producción, cambiar a SMTP real (Gmail, SendGrid, etc.)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-email@gmail.com
# MAIL_PASSWORD=tu-app-password
# MAIL_ENCRYPTION=tls

# SANCTUM - Autenticación API
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:4200,127.0.0.1,127.0.0.1:4200
SANCTUM_EXPIRATION=null

# FRONTEND URL - Para CORS y enlaces
FRONTEND_URL=http://localhost:4200

# BROADCAST & QUEUE - Para características avanzadas
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# REDIS - Cache avanzado (opcional)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# AWS - Para almacenamiento en la nube (opcional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

VITE_APP_NAME="${APP_NAME}"