# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Dependencies
node_modules/
laravel-backend/node_modules/
laravel-backend/vendor/

# Angular and build output
dist/
tmp/
out-tsc/
bazel-out/
.angular/
coverage/
typings/
__screenshots__/

# Laravel generated files
laravel-backend/storage/*.key
laravel-backend/storage/app/*
!laravel-backend/storage/app/.gitignore
laravel-backend/storage/framework/cache/*
!laravel-backend/storage/framework/cache/.gitkeep
laravel-backend/storage/framework/sessions/*
!laravel-backend/storage/framework/sessions/.gitignore
laravel-backend/storage/framework/views/*
!laravel-backend/storage/framework/views/.gitignore
laravel-backend/storage/logs/*
!laravel-backend/storage/logs/.gitignore
laravel-backend/bootstrap/cache/*
laravel-backend/public/build/
laravel-backend/public/hot
laravel-backend/.phpunit.result.cache
laravel-backend/.phpunit.cache/
laravel-backend/database/dumps/*.sql

# Environment and local databases
.env
.env.*
!.env.example
laravel-backend/.env
laravel-backend/.env.*
!laravel-backend/.env.example
*.sqlite
*.sqlite-journal

# Logs and package-manager output
*.log
npm-debug.log
yarn-error.log

# IDEs and operating-system files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/
.project
.classpath
.c9/
.settings/
*.launch
*.sublime-workspace
.DS_Store
Thumbs.db
*.swp
*.swo

# Temporary files and sensitive keys
.sass-cache/
.tmp/
temp/
connect.lock
libpeerconnection.log
testem.log
*.pem
*.key